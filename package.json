    "start": "next start -p 3100 -H 127.0.0.1",
    "lint": "eslint",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/unit/**/*.test.mjs\"",
    "test:e2e:privacy": "node tests/e2e/cross-user-privacy.test.mjs",
    "test:e2e:f2": "node tests/e2e/add-appointment.test.mjs",
    "test:e2e:f3": "node tests/e2e/appointment-detail.test.mjs",
    "test:e2e:qa": "node tests/e2e/responsive-qa.test.mjs",
    "test:e2e:quickadd": "node tests/e2e/quick-add.test.mjs",
    "test:e2e:f5": "node tests/e2e/calendar-availability.test.mjs",
    "test:e2e:dashboard": "node tests/e2e/dashboard-scope.test.mjs",
    "test:availability": "node supabase/tests/availability-finder-regression.mjs",
    "test:past-guard": "node supabase/tests/past-guard-and-config-regression.mjs",
    "test:cleanup-safety": "node supabase/tests/cleanup-safety-regression.mjs",
    "test:past-recording": "node supabase/tests/past-appointment-recording-regression.mjs",
    "test:working-hours": "node supabase/tests/working-hours-boundary-regression.mjs",
    "test:error-mapping": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/tests/error-mapping-coverage-regression.mjs",
    "test:regression": "node supabase/tests/run-all.mjs",
    "test:security": "node supabase/tests/security-regression.mjs",
    "test:engine": "node supabase/tests/appointment-engine-regression.mjs",
    "test:privacy": "node supabase/tests/cross-workspace-privacy-regression.mjs",
    "db:migrate-test": "node scripts/apply-migrations.mjs",
    "db:seed-test": "node scripts/seed-test-project.mjs",
    "db:check-parity": "node scripts/check-migration-parity.mjs",
    "dev:inspect": "node scripts/dev-inspect.mjs",
    "db:reset-dev-fixtures": "node supabase/tests/reset-dev-fixtures.mjs"
