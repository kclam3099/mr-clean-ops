# Copy to .env.local and fill in real values from the Supabase dashboard
# (Project Settings → API). .env.local is gitignored — never commit it.
#
# NO REAL VALUES BELONG IN THIS FILE. This file only documents which
# variables exist; see Blueprint v0.2 §B and Phase 1 Build Plan §1G.

# --- Client-safe (NEXT_PUBLIC_*) ---
# These are designed to be public — they identify the project and let the
# browser talk to Supabase through Row Level Security, which is the real
# authorization boundary (Blueprint v0.2 §F). Safe in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only — NEVER prefix these NEXT_PUBLIC_, never import in a
# 'use client' file, never log, never commit ---
# Bypasses Row Level Security entirely. Used in almost no code paths
# (Phase 1 Build Plan §1C). Not wired into any environment as of Step 1.
SUPABASE_SERVICE_ROLE_KEY=

# --- CLI / migration administration only — NOT an application runtime
# variable. Used solely for `supabase link` / `supabase db push` from a
# developer machine or CI migration job, never read by the Next.js app
# itself (per the Step 1 lock: "minimum required credentials at runtime"). ---
SUPABASE_DB_PASSWORD=

# --- DEV regression suites only (supabase/tests) — never used by the app ---
# The shared password for the five synthetic DEV test identities. These are
# fictional accounts on a DEV project; no real person's credentials belong here.
TEST_IDENTITY_PASSWORD=
# Pooler connection used ONLY to build and tear down test fixtures.
SUPABASE_DB_USER=
# Optional; defaults to the DEV pooler host.
SUPABASE_DB_HOST=
