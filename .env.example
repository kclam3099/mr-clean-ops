# Copy to .env.local and fill in real values from the Supabase dashboard
# (Project Settings → API). .env.local is gitignored — never commit it.
#
# NO REAL VALUES BELONG IN THIS FILE. This file only documents which
# variables exist; see Blueprint v0.2 §B and Phase 1 Build Plan §1G.

# --- Client-safe (NEXT_PUBLIC_*) ---
# These are designed to be public — they identify the project and let the
# browser talk to Supabase through Row Level Security, which is the real
# authorization boundary (Blueprint v0.2 §F). Safe in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only — NEVER prefix these NEXT_PUBLIC_, never import in a
# 'use client' file, never log, never commit ---
# Bypasses Row Level Security entirely. Used in almost no code paths
# (Phase 1 Build Plan §1C). Not wired into any environment as of Step 1.
SUPABASE_SERVICE_ROLE_KEY=

# --- CLI / migration administration only — NOT an application runtime
# variable. Used solely for `supabase link` / `supabase db push` from a
# developer machine or CI migration job, never read by the Next.js app
# itself (per the Step 1 lock: "minimum required credentials at runtime"). ---
SUPABASE_DB_PASSWORD=

# --- DEV regression suites only (supabase/tests) — never used by the app ---
# The shared password for the five synthetic DEV test identities. These are
# fictional accounts on a DEV project; no real person's credentials belong here.
TEST_IDENTITY_PASSWORD=
# Pooler connection used ONLY to build and tear down test fixtures.
SUPABASE_DB_USER=
# Optional; defaults to the DEV pooler host.
SUPABASE_DB_HOST=

# ---------------------------------------------------------------------------
# --- The dedicated TEST Supabase project (automated suites only) ---
#
# DEV above is the owner's environment: the local preview on :3100 talks to it
# and real bookings live there. Automated suites talk to a SEPARATE project, so
# a destructive teardown has nothing of value to destroy.
#
# EXPECTED_TEST_PROJECT_REF is the environment stating which project it believes
# it is talking to. The guard requires the live connection to agree with that
# claim AND the ref to be on the reviewed allowlist in
# supabase/tests/lib/target.mjs. Both, or the run refuses.
# ---------------------------------------------------------------------------
EXPECTED_TEST_PROJECT_REF=
TEST_SUPABASE_URL=

# Ordinary clients, E2E sign-in, every RLS path. This is the key a browser would
# hold, so a suite using it is subject to the same boundary the product is.
TEST_SUPABASE_PUBLISHABLE_KEY=

# Trusted TEST setup tooling ONLY — Auth Admin user creation, nothing else.
# It BYPASSES Row Level Security, which is the boundary the suites exist to
# test, so it must never reach a suite, a browser bundle, a React prop, an
# RSC/Flight payload, a log, a report, or git.
TEST_SUPABASE_SECRET_KEY=

# Pooler connection used ONLY to build, tear down and seed TEST fixtures.
TEST_SUPABASE_DB_USER=
TEST_SUPABASE_DB_PASSWORD=
# Optional; defaults to the ap-southeast-1 pooler host.
TEST_SUPABASE_DB_HOST=

# TEST_IDENTITY_PASSWORD (above) is shared by both projects' synthetic
# identities. No real person's password belongs in either.
