{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run deploy:prod)",
      "Bash(vercel whoami)",
      "Bash(vercel ls:*)",
      "Bash(vercel inspect:*)",
      "Bash(vercel logs:*)",
      "Bash(vercel env ls:*)",
      "Bash(vercel env add:*)",
      "Bash(vercel env rm:*)",
      "Bash(vercel --prod)",
      "Bash(vercel deploy --prod)",
      "Bash(vercel domains ls:*)",
      "Bash(vercel domains inspect:*)",
      "Bash(vercel domains add:*)"
    ],
    "deny": [
      "Bash(vercel remove:*)",
      "Bash(vercel rm:*)",
      "Bash(vercel project rm:*)",
      "Bash(vercel project remove:*)",
      "Bash(vercel domains rm:*)",
      "Bash(vercel domains remove:*)",
      "Bash(vercel domains transfer-in:*)",
      "Bash(vercel domains move:*)",
      "Bash(vercel dns:*)",
      "Bash(vercel alias:*)",
      "Bash(vercel teams:*)",
      "Bash(vercel billing:*)"
    ]
  }
}
